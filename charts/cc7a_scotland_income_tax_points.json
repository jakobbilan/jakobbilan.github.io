{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Point map of Scotland's 32 councils. Each circle sits at the council's coordinates; its area shows how much more income tax a person on the council's 2024 annual pay figure owes under Scotland's 2024-25 bands than under the rest of the UK's, and its colour shows the pay figure.",
  "width": "container",
  "height": 600,
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/jhellingsdata/map-data/refs/heads/main/gbr/LAD_SCT_2026_05.json",
        "format": {
          "type": "topojson",
          "feature": "geog"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6e8eb",
        "stroke": "white",
        "strokeWidth": 0.8
      }
    },
    {
      "data": {
        "url": "data/cc7_scotland_councils.csv"
      },
      "mark": {
        "type": "circle",
        "stroke": "#16191d",
        "strokeWidth": 0.6,
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "difference",
          "type": "quantitative",
          "title": "Extra tax (£ a year)",
          "scale": {
            "type": "linear",
            "zero": true,
            "range": [
              0,
              600
            ]
          },
          "legend": {
            "values": [
              50,
              100,
              200
            ],
            "orient": "top-left",
            "title": "Extra tax a year",
            "format": "$,.0f",
            "symbolFillColor": "#7f9fcd"
          }
        },
        "color": {
          "field": "pay",
          "type": "quantitative",
          "title": "Pay, 2024 (£)",
          "scale": {
            "range": [
              "#d2deee",
              "#173c72"
            ]
          },
          "legend": {
            "format": "$,.0f",
            "orient": "top-left",
            "title": "Annual pay, 2024",
            "gradientLength": 140
          }
        },
        "stroke": {
          "condition": {
            "param": "hp",
            "empty": false,
            "value": "#c4532d"
          },
          "value": "#16191d"
        },
        "strokeWidth": {
          "condition": {
            "param": "hp",
            "empty": false,
            "value": 2
          },
          "value": 0.6
        },
        "tooltip": {
          "field": "tt",
          "type": "nominal"
        }
      },
      "params": [
        {
          "name": "hp",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "transform": [
        {
          "calculate": "{'title': datum.name, 'Extra tax a year': '£' + format(datum.difference, ',.0f'), 'Pay, 2024': '£' + format(datum.pay, ',.0f')}",
          "as": "tt"
        }
      ]
    },
    {
      "data": {
        "url": "data/cc7_scotland_councils.csv"
      },
      "transform": [
        {
          "filter": {
            "field": "name",
            "oneOf": [
              "Angus",
              "Shetland Islands",
              "City of Edinburgh"
            ]
          }
        },
        {
          "calculate": "datum.name + ' +£' + format(datum.difference, ',.0f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 11,
        "fontSize": 12,
        "fontWeight": 600,
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/cc7_scotland_councils.csv"
      },
      "transform": [
        {
          "filter": {
            "field": "name",
            "oneOf": [
              "Angus",
              "Shetland Islands",
              "City of Edinburgh"
            ]
          }
        },
        {
          "calculate": "datum.name + ' +£' + format(datum.difference, ',.0f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 11,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#16191d"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/cc7_scotland_councils.csv"
      },
      "transform": [
        {
          "filter": {
            "field": "name",
            "oneOf": [
              "East Dunbartonshire"
            ]
          }
        },
        {
          "calculate": "datum.name + ' +£' + format(datum.difference, ',.0f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -11,
        "fontSize": 12,
        "fontWeight": 600,
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/cc7_scotland_councils.csv"
      },
      "transform": [
        {
          "filter": {
            "field": "name",
            "oneOf": [
              "East Dunbartonshire"
            ]
          }
        },
        {
          "calculate": "datum.name + ' +£' + format(datum.difference, ',.0f')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -11,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#16191d"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "usermeta": {
    "compactDropLayers": [
      2,
      3,
      4,
      5
    ],
    "compactLegend": {
      "orient": "bottom",
      "direction": "horizontal"
    }
  }
}