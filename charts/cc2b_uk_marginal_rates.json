        "fontWeight": 600,
        "fontSize": 13,
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "y": {
          "field": "rate",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
