{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive line chart of England's strategic authorities. One menu chooses the indicator, another the authority to highlight; the other authorities are grey lines and the dashed line is the median authority in each year.",
  "width": "container",
  "height": 320,
  "params": [
    {
      "name": "indicator",
      "value": "life_expectancy_male",
      "bind": {
        "input": "select",
        "options": [
          "life_expectancy_male",
          "pay_fulltime",
          "gva_per_head",
          "employment_rate",
          "old_age_dependency",
          "emissions_per_head"
        ],
        "labels": [
          "Male life expectancy at birth",
          "Median full-time pay of residents",
          "Economic output (GVA) per resident",
          "Employment rate, ages 16 to 64",
          "People aged 65+ per 100 aged 16 to 64",
          "Greenhouse gas emissions per resident"
        ],
        "name": "Indicator "
      }
    },
    {
      "name": "area",
      "value": "MSA001",
      "bind": {
        "input": "select",
        "options": [
          "MSA008",
          "MSA017",
          "MSA016",
          "MSA018",
          "MSA011",
          "MSA013",
          "MSA019",
          "MSA022",
          "MSA001",
          "MSA015",
          "MSA012",
          "MSA020",
          "MSA003",
          "MSA021",
          "MSA007",
          "MSA004",
          "MSA014",
          "MSA006",
          "MSA002",
          "MSA005",
          "MSA009",
          "MSA010"
        ],
        "labels": [
          "Cambridgeshire and Peterborough",
          "Cheshire and Warrington",
          "Cumbria",
          "Devon and Torbay",
          "East Midlands",
          "Greater Essex",
          "Greater Lincolnshire",
          "Greater London",
          "Greater Manchester",
          "Hampshire and the Solent",
          "Hull and East Yorkshire",
          "Lancashire",
          "Liverpool City Region",
          "Norfolk and Suffolk",
          "North East",
          "South Yorkshire",
          "Sussex and Brighton",
          "Tees Valley",
          "West Midlands",
          "West Yorkshire",
          "West of England",
          "York and North Yorkshire"
        ],
        "name": "Authority "
      }
    }
  ],
  "data": {
    "url": "data/cc9_strategic_authorities.csv"
  },
  "transform": [
    {
      "filter": "datum.indicator == indicator"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "scale": {
        "zero": false,
        "nice": false
      },
      "axis": {
        "format": "d",
        "tickCount": 8,
        "grid": false
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": null,
      "scale": {
        "zero": false
      },
      "axis": {
        "labelExpr": "abs(datum.value) >= 10000 ? format(datum.value / 1000, ',.0f') + 'k' : format(datum.value, ',')",
        "minExtent": 50
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 1.3,
        "color": "#c9ced4",
        "opacity": 1
      },
      "encoding": {
        "detail": {
          "field": "geo_id"
        }
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "median",
              "field": "value",
              "as": "value"
            }
          ],
          "groupby": [
            "year"
          ]
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1.6,
        "strokeDash": [
          5,
          3
        ],
        "color": "#5b636d"
      }
    },
    {
      "transform": [
        {
          "filter": "datum.geo_id == area"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.6,
        "color": "#c4532d",
        "point": {
          "filled": true,
          "size": 18,
          "color": "#c4532d"
        }
      },
      "encoding": {}
    },
    {
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "median",
              "field": "value",
              "as": "median"
            }
          ],
          "groupby": [
            "year"
          ]
        },
        {
          "filter": "datum.geo_id == area"
        },
        {
          "calculate": "{'title': datum.name + ', ' + datum.date, 'Value': format(datum.value, ',.3~r'), 'Median authority': format(datum.median, ',.3~r')}",
          "as": "tt"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1,
        "color": "#16191d"
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "year"
            ],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "encoding": {
        "y": null,
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 0.7
          },
          "value": 0
        },
        "tooltip": {
          "field": "tt",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.geo_id == area"
        },
        {
          "aggregate": [
            {
              "op": "argmax",
              "field": "year",
              "as": "last"
            }
          ],
          "groupby": [
            "name"
          ]
        },
        {
          "calculate": "datum.last.year",
          "as": "year"
        },
        {
          "calculate": "datum.last.value",
          "as": "value"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dy": -12,
        "fontWeight": 600,
        "dx": -4,
        "fontSize": 12.5,
        "stroke": "white",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "text": {
          "field": "name"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.geo_id == area"
        },
        {
          "aggregate": [
            {
              "op": "argmax",
              "field": "year",
              "as": "last"
            }
          ],
          "groupby": [
            "name"
          ]
        },
        {
          "calculate": "datum.last.year",
          "as": "year"
        },
        {
          "calculate": "datum.last.value",
          "as": "value"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dy": -12,
        "fontWeight": 600,
        "color": "#c4532d",
        "dx": -4,
        "fontSize": 12.5
      },
      "encoding": {
        "text": {
          "field": "name"
        }
      }
    }
  ],
  "padding": {
    "left": 6,
    "right": 12,
    "top": 6,
    "bottom": 6
  },
  "usermeta": {
    "titles": {
      "life_expectancy_male": "Male life expectancy at birth",
      "pay_fulltime": "Median full-time pay of residents",
      "gva_per_head": "Economic output (GVA) per resident",
      "employment_rate": "Employment rate, ages 16 to 64",
      "old_age_dependency": "People aged 65+ per 100 aged 16 to 64",
      "emissions_per_head": "Greenhouse gas emissions per resident"
    },
    "units": {
      "life_expectancy_male": "Years, three-year average",
      "pay_fulltime": "£ a year",
      "gva_per_head": "£ per resident, current prices",
      "employment_rate": "% of residents aged 16 to 64",
      "old_age_dependency": "Old-age dependency ratio",
      "emissions_per_head": "Tonnes of CO2 equivalent per resident"
    }
  }
}