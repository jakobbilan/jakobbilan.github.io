{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Paired stacked bars: capital taxes as a share of all tax revenue in 2006 (upper, lighter bar) and 2019 (lower bar) for eight large economies, split into corporate income, capital stock and personal capital income taxes, with corporate income on the common baseline; countries sorted by the change, which is stated in a column on the right.",
  "data": {
    "url": "data/cc4_ft_tax_shares.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "share": "number",
        "gdp_share": "number",
        "order": "number"
      }
    }
  },
  "width": "container",
  "height": 400,
  "transform": [
    {
      "filter": "indexof(['capital_income_corporations', 'capital_stocks', 'capital_income_households'], datum.tax) >= 0"
    },
    {
      "calculate": "datum.tax == 'capital_income_corporations' ? 'Corporate income' : datum.tax == 'capital_stocks' ? 'Capital stock (property)' : 'Personal capital income'",
      "as": "tax_short"
    },
    {
      "calculate": "indexof(['capital_income_corporations', 'capital_stocks', 'capital_income_households'], datum.tax)",
      "as": "stack_order"
    },
    {
      "calculate": "toString(datum.year)",
      "as": "year_label"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "share",
          "as": "total"
        }
      ],
      "groupby": [
        "country",
        "year"
      ]
    },
    {
      "calculate": "datum.year == 2019 ? datum.share : -datum.share",
      "as": "signed"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "signed",
          "as": "change"
        }
      ],
      "groupby": [
        "country"
      ]
    },
    {
      "calculate": "datum.year == 2019 ? round(datum.total * 10) / 10 : null",
      "as": "t19"
    },
    {
      "calculate": "datum.year == 2006 ? round(datum.total * 10) / 10 : null",
      "as": "t06"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "t19",
          "as": "T19"
        },
        {
          "op": "max",
          "field": "t06",
          "as": "T06"
        }
      ],
      "groupby": [
        "country"
      ]
    },
    {
      "calculate": "datum.T19 - datum.T06",
      "as": "change_shown"
    },
    {
      "calculate": "{'title': datum.tax_short + ', ' + datum.country + ' ' + datum.year, 'Share of all tax revenue': format(datum.share, '.1f') + '%', 'All capital taxes': format(datum.total, '.1f') + '%'}",
      "as": "tt"
    }
  ],
  "encoding": {
    "y": {
      "field": "country",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "change",
        "op": "min",
        "order": "ascending"
      },
      "scale": {
        "paddingInner": 0.34,
        "paddingOuter": 0.12
      },
      "axis": {
        "labelFontSize": 13,
        "labelColor": "#16191d",
        "labelPadding": 10,
        "domain": false,
        "ticks": false
      }
    },
    "yOffset": {
      "field": "year_label",
      "type": "nominal",
      "sort": [
        "2006",
        "2019"
      ],
      "scale": {
        "paddingInner": 0.14
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative",
          "stack": "zero",
          "title": null,
          "scale": {
            "domain": [
              0,
              37
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              5,
              10,
              15,
              20,
              25,
              30,
              35
            ],
            "labelExpr": "datum.value + '%'",
            "grid": true
          }
        },
        "color": {
          "field": "tax_short",
          "type": "nominal",
          "title": null,
          "sort": [
            "Corporate income",
            "Capital stock (property)",
            "Personal capital income"
          ],
          "scale": {
            "domain": [
              "Corporate income",
              "Capital stock (property)",
              "Personal capital income"
            ],
            "range": [
              "#c4532d",
              "#7f8fa6",
              "#c3c9d1"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square",
            "symbolSize": 120,
            "labelFontSize": 12.5
          }
        },
        "opacity": {
          "condition": {
            "test": "datum.year == 2006",
            "value": 0.55
          },
          "value": 1
        },
        "order": {
          "field": "stack_order",
          "type": "quantitative"
        },
        "tooltip": {
          "field": "tt",
          "type": "nominal"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#16191d",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "yOffset": null
      }
    },
    {
      "transform": [
        {
          "filter": "datum.tax == 'capital_income_corporations' && datum.year == 2006"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 11.5,
        "color": "#5b636d"
      },
      "encoding": {
        "x": {
          "field": "total",
          "type": "quantitative"
        },
        "text": {
          "field": "total",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.tax == 'capital_income_corporations' && datum.year == 2019"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#16191d"
      },
      "encoding": {
        "x": {
          "field": "total",
          "type": "quantitative"
        },
        "text": {
          "field": "total",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.tax == 'capital_income_corporations'"
        },
        {
          "window": [
            {
              "op": "dense_rank",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "change",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank == 1"
        },
        {
          "calculate": "format(datum.total, '.1f')",
          "as": "total_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 36,
        "fontSize": 11,
        "color": "#5b636d"
      },
      "encoding": {
        "x": {
          "field": "total",
          "type": "quantitative"
        },
        "text": {
          "field": "year_label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.tax == 'capital_income_corporations' && datum.year == 2019"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 12.5,
        "fontWeight": 600,
        "color": "#16191d"
      },
      "encoding": {
        "x": {
          "datum": 37,
          "type": "quantitative"
        },
        "yOffset": null,
        "text": {
          "field": "change_shown",
          "type": "quantitative",
          "format": "+.1f"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.tax == 'capital_income_corporations' && datum.year == 2019"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "rank"
            }
          ],
          "sort": [
            {
              "field": "change",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum.rank == 1"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dy": -24,
        "fontSize": 11,
        "color": "#5b636d"
      },
      "encoding": {
        "x": {
          "datum": 37,
          "type": "quantitative"
        },
        "yOffset": null,
        "text": {
          "value": "Change, pts"
        }
      }
    }
  ],
  "usermeta": {
    "compactLegend": {
      "columns": 2
    },
    "compactDropLayers": [
      4
    ],
    "compactSet": [
      [
        "encoding.y.axis.labelFontSize",
        11.5
      ]
    ]
  },
  "padding": {
    "left": 4,
    "right": 8,
    "top": 4,
    "bottom": 4
  }
}