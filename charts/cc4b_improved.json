{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Four panels of arrows on one scale: capital taxes as a share of all tax revenue in eight countries, one arrow per country from 2006 to 2019, for all capital taxes, corporate income, capital stock and personal capital income. Countries are sorted by the change in all capital taxes; the changes in all capital taxes and in corporate income are written beside the arrowheads.",
  "data": {
    "url": "data/cc4_ft_tax_shares.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "share": "number",
        "gdp_share": "number",
        "order": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "indexof(['capital_income_corporations', 'capital_stocks', 'capital_income_households'], datum.tax) >= 0"
    },
    {
      "pivot": "tax",
      "value": "share",
      "groupby": [
        "country",
        "year"
      ]
    },
    {
      "calculate": "datum.capital_income_corporations + datum.capital_stocks + datum.capital_income_households",
      "as": "all"
    },
    {
      "fold": [
        "all",
        "capital_income_corporations",
        "capital_stocks",
        "capital_income_households"
      ],
      "as": [
        "component",
        "value"
      ]
    },
    {
      "calculate": "'y' + datum.year",
      "as": "yr"
    },
    {
      "pivot": "yr",
      "value": "value",
      "groupby": [
        "country",
        "component"
      ]
    },
    {
      "calculate": "round(datum.y2019 * 10) / 10 - round(datum.y2006 * 10) / 10",
      "as": "change"
    },
    {
      "calculate": "datum.change < -0.05 ? 'M0,0L1.15,-0.62L1.15,0.62Z' : datum.change > 0.05 ? 'M0,0L-1.15,-0.62L-1.15,0.62Z' : 'circle'",
      "as": "head"
    },
    {
      "calculate": "datum.component == 'all' ? datum.change : null",
      "as": "change_all"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "change_all",
          "as": "sort_key"
        }
      ],
      "groupby": [
        "country"
      ]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "row"
        }
      ],
      "sort": [
        {
          "field": "sort_key",
          "order": "ascending"
        }
      ]
    }
  ],
  "spacing": 26,
  "resolve": {
    "scale": {
      "y": "shared"
    }
  },
  "hconcat": [
    {
      "title": {
        "text": [
          "All capital",
          "taxes"
