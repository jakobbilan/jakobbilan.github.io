{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Arrow chart: capital taxes as a share of all tax revenue in eight countries, one arrow per country from 2006 to 2019, in four columns on one shared scale: all capital taxes, then corporate income, capital stock and personal capital income. Countries are sorted by the change in all capital taxes; the changes in all capital taxes and in corporate income are written beside the arrowheads.",
  "data": {
    "url": "data/cc4_ft_tax_shares.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "share": "number",
        "gdp_share": "number",
        "order": "number"
      }
    }
  },
  "width": "container",
  "height": 330,
  "padding": {
    "left": 4,
    "right": 10,
    "top": 6,
    "bottom": 4
  },
  "transform": [
    {
      "filter": "indexof(['capital_income_corporations', 'capital_stocks', 'capital_income_households'], datum.tax) >= 0"
    },
    {
      "pivot": "tax",
      "value": "share",
      "groupby": [
        "country",
        "year"
      ]
    },
    {
      "calculate": "datum.capital_income_corporations + datum.capital_stocks + datum.capital_income_households",
      "as": "all"
    },
    {
      "fold": [
        "all",
        "capital_income_corporations",
        "capital_stocks",
        "capital_income_households"
      ],
      "as": [
        "component",
        "value"
      ]
    },
    {
      "calculate": "'y' + datum.year",
      "as": "yr"
    },
    {
      "pivot": "yr",
      "value": "value",
      "groupby": [
        "country",
        "component"
      ]
    },
    {
      "calculate": "round(datum.y2019 * 10) / 10 - round(datum.y2006 * 10) / 10",
      "as": "change"
    },
    {
      "calculate": "datum.component == 'all' ? -6.0 : datum.component == 'capital_income_corporations' ? 27.6 : datum.component == 'capital_stocks' ? 46.2 : 64.8",
      "as": "offset"
    },
    {
      "calculate": "datum.component == 'all' ? 0.0 : datum.component == 'capital_income_corporations' ? 29.6 : datum.component == 'capital_stocks' ? 48.2 : 64.8",
      "as": "col_start"
    },
    {
      "calculate": "datum.component == 'all' ? 27.0 : datum.component == 'capital_income_corporations' ? 45.6 : datum.component == 'capital_stocks' ? 62.2 : 71.3",
      "as": "col_end"
    },
    {
      "calculate": "datum.component == 'all' ? 'All capital taxes' : datum.component == 'capital_income_corporations' ? 'Corporate income' : datum.component == 'capital_stocks' ? 'Capital stock (property)' : 'Personal capital income'",
      "as": "label"
    },
    {
      "calculate": "datum.y2006 + datum.offset",
      "as": "x0"
    },
    {
      "calculate": "datum.y2019 + datum.offset",
      "as": "x1"
    },
    {
      "calculate": "datum.change < -0.05 ? 'M0,0L1.15,-0.62L1.15,0.62Z' : datum.change > 0.05 ? 'M0,0L-1.15,-0.62L-1.15,0.62Z' : 'circle'",
      "as": "head"
    },
    {
      "calculate": "datum.component == 'all' ? datum.change : null",
      "as": "change_all"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "change_all",
          "as": "sort_key"
        }
      ],
      "groupby": [
        "country"
      ]
    },
    {
      "calculate": "{'title': datum.country + ': ' + lower(datum.label), '2006': format(datum.y2006, '.1f') + '%', '2019': format(datum.y2019, '.1f') + '%', 'Change': format(datum.change, '+.1f') + ' points'}",
      "as": "tt"
    }
  ],
  "encoding": {
    "y": {
      "field": "country",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "sort_key",
        "op": "min",
        "order": "ascending"
      },
      "scale": {
        "paddingInner": 0,
        "paddingOuter": 0
      },
      "axis": {
        "labelFontSize": 13,
        "labelColor": "#16191d",
        "labelPadding": 12,
        "domain": false,
        "ticks": false,
        "grid": false
      }
    }
  },
