{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bridge chart of total tax rates (all taxes as % of income), United States, 2018-20 averages. Full population: 30.2% in Balkir et al. (2025); 25% in Splinter (2025), who adds transfers to income and subtracts refundable credits from taxes (-5 points). Top 400: 23.8% in Balkir et al. (range 21.7-26.4%); Splinter's adjustments add 3 points for removing 'pure' capital gains from income, 8 for splitting family fortunes across tax returns and 3 for likely missing state income taxes, reaching 38% (range 34-44%).",
  "data": {
    "url": "data/cc3_splinter_bridge.csv",
    "format": {
      "type": "csv",
      "parse": {
        "order": "number",
        "start": "number",
        "end": "number",
        "value": "number",
        "range_low": "number",
        "range_high": "number"
      }
    }
  },
  "width": "container",
  "height": 300,
  "encoding": {
    "y": {
      "field": "row",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "h_pop",
          "pop_bsyz",
          "pop_splinter",
          "h_top",
          "top_bsyz",
          "step_gains",
          "step_family",
          "step_salt",
          "top_splinter"
        ],
        "paddingInner": 0.34,
        "paddingOuter": 0.12
      },
      "axis": {
        "labelExpr": "{'h_pop': 'Full population', 'h_top': 'Top 400', 'pop_bsyz': 'Balkir et al.', 'pop_splinter': 'Splinter', 'top_bsyz': 'Balkir et al.', 'step_gains': 'Remove “pure” capital gains from income', 'step_family': 'Split family fortunes across tax returns', 'step_salt': 'Add likely missing state income taxes', 'top_splinter': 'Splinter'}[datum.value]",
        "labelAlign": "left",
        "labelPadding": 262,
        "labelLimit": 250,
        "labelFontSize": 12.5,
        "labelColor": "#16191d",
        "labelFontWeight": {
          "condition": {
            "test": "datum.value === 'h_pop' || datum.value === 'h_top'",
            "value": 700
          },
          "value": 400
        },
        "grid": false
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "filter": "isValid(datum.continues_from) && datum.continues_from !== ''"
        },
        {
          "calculate": "datum.kind === 'change' && datum.value > 0 ? datum.start : datum.end",
          "as": "link_x"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#8d96a0",
        "strokeWidth": 1,
        "strokeDash": [
          2,
          2
        ]
      },
      "encoding": {
        "x": {
          "field": "link_x",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              0,
              50
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              10,
              20,
              30,
              40,
              50
            ],
            "labelExpr": "datum.value + '%'",
            "grid": false
          }
        },
        "y": {
          "field": "continues_from"
        },
        "y2": {
          "field": "row"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "!(datum.kind === 'change' && datum.value < 0)"
        },
        {
          "calculate": "datum.kind === 'change' ? 'adjustment' : datum.group",
          "as": "fill_key"
        },
        {
          "calculate": "datum.kind === 'rate' ? (isValid(datum.range_low) ? {'title': datum.name, 'Total tax rate': datum.value_label, 'Range': format(datum.range_low, '.3~r') + '–' + format(datum.range_high, '.3~r') + '%'} : {'title': datum.name, 'Total tax rate': datum.value_label}) : {'title': datum.name, 'Change': datum.value_label}",
          "as": "tt"
        }
      ],
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "quantitative"
        },
        "x2": {
          "field": "end"
        },
        "color": {
          "field": "fill_key",
          "type": "nominal",
          "legend": null,
          "scale": {
            "domain": [
              "full_population",
              "top_400",
              "adjustment"
            ],
            "range": [
              "#a3acb6",
              "#1f4e8c",
              "#c4532d"
            ]
          }
        },
        "tooltip": {
          "field": "tt",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind === 'change' && datum.value < 0"
        },
        {
          "calculate": "datum.kind === 'rate' ? (isValid(datum.range_low) ? {'title': datum.name, 'Total tax rate': datum.value_label, 'Range': format(datum.range_low, '.3~r') + '–' + format(datum.range_high, '.3~r') + '%'} : {'title': datum.name, 'Total tax rate': datum.value_label}) : {'title': datum.name, 'Change': datum.value_label}",
          "as": "tt"
        }
      ],
      "mark": {
        "type": "bar",
        "fill": "#c4532d",
        "fillOpacity": 0.1,
        "stroke": "#c4532d",
        "strokeWidth": 1.25,
        "strokeDash": [
          3,
          2
        ]
      },
      "encoding": {
        "x": {
          "field": "start",
          "type": "quantitative"
        },
        "x2": {
          "field": "end"
        },
        "tooltip": {
          "field": "tt",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind === 'rate'"
        },
        {
          "calculate": "datum.kind === 'rate' ? (isValid(datum.range_low) ? {'title': datum.name, 'Total tax rate': datum.value_label, 'Range': format(datum.range_low, '.3~r') + '–' + format(datum.range_high, '.3~r') + '%'} : {'title': datum.name, 'Total tax rate': datum.value_label}) : {'title': datum.name, 'Change': datum.value_label}",
          "as": "tt"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "middle",
        "dx": -6,
        "fontSize": 12.5,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "end",
          "type": "quantitative"
        },
        "text": {
          "field": "value_label"
        },
        "color": {
          "condition": {
            "test": "datum.group === 'top_400'",
            "value": "#ffffff"
          },
          "value": "#16191d"
        },
        "tooltip": {
          "field": "tt",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.kind === 'change'"
        },
        {
          "calculate": "datum.kind === 'rate' ? (isValid(datum.range_low) ? {'title': datum.name, 'Total tax rate': datum.value_label, 'Range': format(datum.range_low, '.3~r') + '–' + format(datum.range_high, '.3~r') + '%'} : {'title': datum.name, 'Total tax rate': datum.value_label}) : {'title': datum.name, 'Change': datum.value_label}",
          "as": "tt"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 12.5,
        "fontWeight": 600,
        "color": "#c4532d"
      },
      "encoding": {
        "x": {
          "field": "end",
          "type": "quantitative"
        },
        "text": {
          "field": "value_label"
        },
        "tooltip": {
          "field": "tt",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "isValid(datum.range_low)"
        },
        {
          "calculate": "'range ' + format(datum.range_low, '.3~r') + '–' + format(datum.range_high, '.3~r') + '%'",
          "as": "range_label"
        },
        {
          "calculate": "datum.kind === 'rate' ? (isValid(datum.range_low) ? {'title': datum.name, 'Total tax rate': datum.value_label, 'Range': format(datum.range_low, '.3~r') + '–' + format(datum.range_high, '.3~r') + '%'} : {'title': datum.name, 'Total tax rate': datum.value_label}) : {'title': datum.name, 'Change': datum.value_label}",
          "as": "tt"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "fontSize": 11.5,
        "color": "#5b636d"
      },
      "encoding": {
        "x": {
          "field": "end",
          "type": "quantitative"
        },
        "text": {
          "field": "range_label"
        },
        "tooltip": {
          "field": "tt",
          "type": "nominal"
        }
      }
    }
  ],
  "usermeta": {
    "compactSet": [
      [
        "encoding.y.axis.labelExpr",
        "split({'h_pop': 'Full population', 'h_top': 'Top 400', 'pop_bsyz': 'Balkir et al.', 'pop_splinter': 'Splinter', 'top_bsyz': 'Balkir et al.', 'step_gains': 'Remove “pure”|capital gains', 'step_family': 'Split family|fortunes', 'step_salt': 'Add likely missing|state income taxes', 'top_splinter': 'Splinter'}[datum.value], '|')"
      ],
      [
        "encoding.y.axis.labelPadding",
        128
      ],
      [
        "encoding.y.axis.labelLimit",
        122
      ],
      [
        "layer.0.encoding.x.axis.values",
        [
          0,
          20,
          40
        ]
      ],
      [
        "encoding.y.axis.labelFontSize",
        11
      ],
      [
        "encoding.y.axis.labelLineHeight",
        13.5
      ],
      [
        "layer.3.mark.fontSize",
        11.5
      ],
      [
        "layer.4.mark.fontSize",
        11.5
      ],
      [
        "layer.5.transform.1.calculate",
        "'(' + format(datum.range_low, '.3~r') + '–' + format(datum.range_high, '.3~r') + ')'"
      ],
      [
        "layer.5.mark.fontSize",
        10.5
      ],
      [
        "layer.5.mark.dx",
        5
      ]
    ]
  }
}
