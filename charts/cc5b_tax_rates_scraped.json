{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "description": "Scatter plot of the top statutory personal income tax rate against the standard VAT, GST or sales tax rate for each jurisdiction in Wikipedia's list of tax rates, coloured by whether the jurisdiction levies a net wealth tax. Data scraped and cleaned in a Colab notebook.",
  "title": {
    "text": "Top income tax rate vs VAT",
    "subtitle": "Statutory rates; colour shows a net wealth tax"
  },
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/cc5_tax_rates_tidy.csv"
  },
  "transform": [
    {
      "pivot": "tax",
      "value": "top_rate_pct",
      "groupby": [
        "jurisdiction",
        "wealth_tax"
      ]
    },
    {
      "filter": "isValid(datum.income_top) && isValid(datum.vat)"
    }
  ],
  "encoding": {
    "x": {
      "field": "income_top",
      "type": "quantitative",
      "title": "Top personal income tax rate (%)",
      "scale": {
        "domain": [
          0,
          70
        ]
      }
    },
    "y": {
      "field": "vat",
      "type": "quantitative",
      "title": "Standard VAT/GST/sales tax (%)",
      "scale": {
        "domain": [
          0,
          32
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 55,
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "color": {
          "field": "wealth_tax",
          "type": "nominal",
          "title": "Net wealth tax",
          "sort": [
            "Yes",
            "Inactive",
            "No",
            "Not listed",
            "Other"
          ],
          "scale": {
            "domain": [
              "Yes",
              "Inactive",
              "No",
              "Not listed",
              "Other"
            ],
            "range": [
              "#B42318",
              "#B7791F",
              "#2F5D8C",
              "#C3CAD3",
              "#5B6472"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "columns": 3,
            "labelLimit": 400
          }
        },
        "tooltip": [
          {
            "field": "jurisdiction",
            "title": "Jurisdiction"
          },
          {
            "field": "income_top",
            "type": "quantitative",
            "title": "Top income tax (%)",
            "format": ".1f"
          },
          {
            "field": "vat",
            "type": "quantitative",
            "title": "VAT/sales (%)",
            "format": ".1f"
          },
          {
            "field": "inheritance",
            "type": "quantitative",
            "title": "Inheritance (%)",
            "format": ".1f"
          },
          {
            "field": "wealth_tax",
            "title": "Wealth tax"
          }
        ],
        "size": {
          "condition": {
            "param": "hp",
            "empty": false,
            "value": 160
          },
          "value": 60
        },
        "stroke": {
          "condition": {
            "param": "hp",
            "empty": false,
            "value": "#1B2A41"
          },
          "value": "white"
        }
      },
      "params": [
        {
          "name": "hp",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": {
            "field": "jurisdiction",
            "oneOf": [
              "France",
              "Norway",
              "Switzerland",
              "Brazil",
              "Hungary"
            ]
          }
        },
        {
          "calculate": "datum.jurisdiction == 'United Kingdom' ? 'UK' : datum.jurisdiction == 'United States' ? 'US' : datum.jurisdiction",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 4,
        "fontSize": 12,
        "stroke": "white",
        "strokeWidth": 3,
        "strokeJoin": "round"
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "jurisdiction",
            "oneOf": [
              "France",
              "Norway",
              "Switzerland",
              "Brazil",
              "Hungary"
            ]
          }
        },
        {
          "calculate": "datum.jurisdiction == 'United Kingdom' ? 'UK' : datum.jurisdiction == 'United States' ? 'US' : datum.jurisdiction",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 4,
        "fontSize": 12,
        "color": "#1B2A41"
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "jurisdiction",
            "oneOf": [
              "United Kingdom",
              "United States"
            ]
          }
        },
        {
          "calculate": "datum.jurisdiction == 'United Kingdom' ? 'UK' : datum.jurisdiction == 'United States' ? 'US' : datum.jurisdiction",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -8,
        "fontSize": 12,
        "stroke": "white",
        "strokeWidth": 3,
        "strokeJoin": "round"
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "jurisdiction",
            "oneOf": [
              "United Kingdom",
              "United States"
            ]
          }
        },
        {
          "calculate": "datum.jurisdiction == 'United Kingdom' ? 'UK' : datum.jurisdiction == 'United States' ? 'US' : datum.jurisdiction",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -8,
        "fontSize": 12,
        "color": "#1B2A41"
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "jurisdiction",
            "oneOf": [
              "Japan"
            ]
          }
        },
        {
          "calculate": "datum.jurisdiction == 'United Kingdom' ? 'UK' : datum.jurisdiction == 'United States' ? 'US' : datum.jurisdiction",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 13,
        "fontSize": 12,
        "stroke": "white",
        "strokeWidth": 3,
        "strokeJoin": "round"
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "jurisdiction",
            "oneOf": [
              "Japan"
            ]
          }
        },
        {
          "calculate": "datum.jurisdiction == 'United Kingdom' ? 'UK' : datum.jurisdiction == 'United States' ? 'US' : datum.jurisdiction",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 13,
        "fontSize": 12,
        "color": "#1B2A41"
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "jurisdiction",
            "oneOf": [
              "Germany",
              "Colombia"
            ]
          }
        },
        {
          "calculate": "datum.jurisdiction == 'United Kingdom' ? 'UK' : datum.jurisdiction == 'United States' ? 'US' : datum.jurisdiction",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": 4,
        "fontSize": 12,
        "stroke": "white",
        "strokeWidth": 3,
        "strokeJoin": "round"
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "jurisdiction",
            "oneOf": [
              "Germany",
              "Colombia"
            ]
          }
        },
        {
          "calculate": "datum.jurisdiction == 'United Kingdom' ? 'UK' : datum.jurisdiction == 'United States' ? 'US' : datum.jurisdiction",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -8,
        "dy": 4,
        "fontSize": 12,
        "color": "#1B2A41"
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "config": {
    "font": "Public Sans, system-ui, -apple-system, Segoe UI, sans-serif",
    "background": null,
    "view": {
      "stroke": null
    },
    "title": {
      "anchor": "start",
      "color": "#1B2A41",
      "fontSize": 17,
      "fontWeight": 600,
      "subtitleColor": "#5B6472",
      "subtitleFontSize": 13,
      "offset": 14,
      "subtitlePadding": 5
    },
    "axis": {
      "labelColor": "#5B6472",
      "titleColor": "#5B6472",
      "titleFontWeight": 500,
      "labelFontSize": 12.5,
      "titleFontSize": 12.5,
      "labelPadding": 4,
      "titlePadding": 8,
      "gridColor": "#D5DAE1",
      "domainColor": "#AEB6C1",
      "tickColor": "#AEB6C1"
    },
    "legend": {
      "labelColor": "#5B6472",
      "titleColor": "#5B6472",
      "labelFontSize": 12.5,
      "titleFontSize": 12.5,
      "titleFontWeight": 500,
      "symbolSize": 110
    },
    "text": {
      "color": "#1B2A41",
      "fontSize": 12.5
    }
  },
  "usermeta": {
    "compactDropLayers": [
      1,
      2,
      3,
      4,
      5,
      6,
      7,
      8
    ]
  }
}