{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Scatter plot of the top statutory personal income tax rate against the standard VAT, GST or sales tax rate for each jurisdiction in Wikipedia's list of tax rates, coloured by whether the jurisdiction levies a net wealth tax. Data scraped and cleaned in a Colab notebook.",
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/cc5_tax_rates_tidy.csv"
  },
  "transform": [
    {
      "pivot": "tax",
      "value": "top_rate_pct",
      "groupby": [
        "jurisdiction",
        "wealth_tax"
      ]
    },
    {
      "filter": "isValid(datum.income_top) && isValid(datum.vat)"
    },
    {
      "calculate": "datum.income_top / 100",
      "as": "income_share"
    },
    {
      "calculate": "datum.vat / 100",
      "as": "vat_share"
    },
    {
      "calculate": "isValid(datum.inheritance) ? datum.inheritance / 100 : null",
      "as": "inheritance_share"
    }
  ],
  "encoding": {
    "x": {
      "field": "income_top",
      "type": "quantitative",
      "title": "Top income tax rate (%)",
      "scale": {
        "domain": [
          0,
          70
        ]
      }
    },
    "y": {
      "field": "vat",
      "type": "quantitative",
      "title": "VAT or sales tax (%)",
      "scale": {
        "domain": [
          0,
          32
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "circle",
        "size": 55,
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "color": {
          "field": "wealth_tax",
          "type": "nominal",
          "title": "Net wealth tax",
          "sort": [
            "Yes",
            "Inactive",
            "No",
            "Not listed",
            "Other"
          ],
          "scale": {
            "domain": [
              "Yes",
              "Inactive",
              "No",
              "Not listed",
              "Other"
            ],
            "range": [
              "#c4532d",
              "#b7a57a",
              "#1f4e8c",
              "#cfd5dc",
              "#7f8fa6"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "columns": 3,
            "labelLimit": 400
          }
        },
        "tooltip": [
          {
            "field": "jurisdiction",
            "title": "Jurisdiction"
          },
          {
            "field": "income_share",
            "type": "quantitative",
            "title": "Top income tax rate",
            "format": ".1%"
          },
          {
            "field": "vat_share",
            "type": "quantitative",
            "title": "VAT or sales tax",
            "format": ".1%"
          },
          {
            "field": "inheritance_share",
            "type": "quantitative",
            "title": "Inheritance tax",
            "format": ".1%"
          },
          {
            "field": "wealth_tax",
            "title": "Net wealth tax"
          }
        ],
        "size": {
          "condition": {
            "param": "hp",
            "empty": false,
            "value": 160
          },
          "value": 60
        },
        "stroke": {
          "condition": {
            "param": "hp",
            "empty": false,
            "value": "#16191d"
          },
          "value": "white"
        }
      },
      "params": [
        {
          "name": "hp",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": {
            "field": "jurisdiction",
            "oneOf": [
              "France",
              "Norway",
              "Switzerland",
              "Brazil",
              "Hungary"
            ]
          }
        },
        {
          "calculate": "datum.jurisdiction == 'United Kingdom' ? 'UK' : datum.jurisdiction == 'United States' ? 'US' : datum.jurisdiction",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 4,
        "fontSize": 12,
        "stroke": "white",
        "strokeWidth": 3,
        "strokeJoin": "round",
        "fontWeight": 500
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": {
            "field": "jurisdiction",
