{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Line chart of the share of pre-tax national income received by the top 1% in the United States, the United Kingdom and France since 1900 (World Inequality Database via Our World in Data). Labels sit at the latest year of each line.",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/cc2a_wid_top1_pretax.csv"
  },
  "transform": [
    {
      "filter": "datum.year >= 1900 && isValid(datum.share)"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          1900,
          2025
        ],
        "nice": false
      },
      "axis": {
        "format": "d",
        "tickCount": 7,
        "grid": false
      }
    },
    "y": {
      "field": "share",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          0,
          25
        ]
      },
      "axis": {
        "tickCount": 5
      }
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "United States",
          "United Kingdom",
          "France"
        ],
        "range": [
          "#c4532d",
          "#1f4e8c",
          "#7f8fa6"
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.6
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 55
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 1
          },
          "value": 0
        }
      }
    },
    {
      "transform": [
        {
          "pivot": "country",
          "value": "share",
          "groupby": [
            "year"
          ]
        },
        {
          "calculate": "{'title': toString(datum.year), 'United States': isValid(datum['United States']) ? format(datum['United States'], '.1f') + '%' : 'no estimate', 'United Kingdom': isValid(datum['United Kingdom']) ? format(datum['United Kingdom'], '.1f') + '%' : 'no estimate', 'France': isValid(datum['France']) ? format(datum['France'], '.1f') + '%' : 'no estimate'}",
          "as": "tt"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": [
              "year"
            ],
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "encoding": {
        "y": null,
        "color": {
          "value": "#16191d"
        },
        "opacity": {
          "condition": {
            "param": "hover",
            "empty": false,
            "value": 0.7
          },
          "value": 0
        },
        "tooltip": {
          "field": "tt",
          "type": "nominal"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.country == 'United States'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 0,
        "fontWeight": 600,
        "fontSize": 12.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "aggregate": "max",
          "type": "quantitative"
        },
        "y": {
          "field": "share",
          "aggregate": {
            "argmax": "year"
          },
          "type": "quantitative"
        },
        "text": {
          "field": "country",
          "aggregate": {
            "argmax": "year"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.country == 'United Kingdom'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": -6,
        "fontWeight": 600,
        "fontSize": 12.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "aggregate": "max",
          "type": "quantitative"
        },
        "y": {
          "field": "share",
          "aggregate": {
            "argmax": "year"
          },
          "type": "quantitative"
        },
        "text": {
          "field": "country",
          "aggregate": {
            "argmax": "year"
          }
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.country == 'France'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "dy": 7,
        "fontWeight": 600,
        "fontSize": 12.5
      },
      "encoding": {
        "x": {
          "field": "year",
          "aggregate": "max",
          "type": "quantitative"
        },
        "y": {
          "field": "share",
          "aggregate": {
            "argmax": "year"
          },
          "type": "quantitative"
        },
        "text": {
          "field": "country",
          "aggregate": {
            "argmax": "year"
          }
        }
      }
    }
  ],
  "usermeta": {
    "compactDropLayers": [
      3,
      4,
      5
    ],
    "compactSet": [
      [
        "encoding.color.legend",
        {
          "orient": "top",
          "direction": "horizontal",
          "title": null,
          "symbolType": "stroke"
        }
      ]
    ]
  }
}