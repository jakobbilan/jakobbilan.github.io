{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Live line chart, loaded from the World Bank Indicators API each time the page opens: income (or consumption) share held by the richest 10% in six countries, from household surveys (World Bank Poverty and Inequality Platform).",
  "width": "container",
  "height": 300,
  "data": {
    "url": "https://api.worldbank.org/v2/country/USA;GBR;FRA;DEU;BRA;ZAF/indicator/SI.DST.10TH.10?format=json&per_page=1000&date=1990:2025",
    "format": {
      "type": "json",
      "property": "[1]"
    }
  },
  "transform": [
    {
      "filter": "datum.value != null"
    },
    {
      "calculate": "toNumber(datum.date)",
      "as": "year"
    },
    {
      "calculate": "datum.country.value",
      "as": "country_name"
    },
    {
      "calculate": "datum.value / 100",
      "as": "share"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          1990,
          2025
        ],
        "nice": false
      },
      "axis": {
        "format": "d",
        "tickCount": 8,
        "grid": false
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          20,
          60
        ]
      }
    },
    "color": {
      "field": "country_name",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "United States",
          "United Kingdom",
          "France",
          "Germany",
          "Brazil",
          "South Africa"
        ],
        "range": [
          "#c4532d",
          "#1f4e8c",
          "#7f8fa6",
          "#b7a57a",
          "#5e8c6a",
          "#3d434b"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "columns": 3,
        "symbolType": "stroke",
        "labelLimit": 400
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "point": {
          "filled": true,
          "size": 18
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 70
      },
      "encoding": {
        "opacity": {
          "condition": {
            "param": "hp",
            "empty": false,
            "value": 1
          },
          "value": 0
        },
        "tooltip": {
          "field": "tt",
          "type": "nominal"
        }
      },
      "params": [
        {
          "name": "hp",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ],
      "transform": [
        {
          "calculate": "{'title': datum.country_name + ', ' + datum.year, 'Richest 10%’s share': format(datum['value'], '.1f') + '%'}",
          "as": "tt"
        }
      ]
    }
  ],
  "usermeta": {
    "compactLegend": {
      "columns": 2
    }
  }
}