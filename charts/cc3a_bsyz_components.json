{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Horizontal stacked bars of total effective tax rates in the United States, 2018-20, for the full population and the wealthiest 400 households, split by type of tax. A reference line marks the roughly 45% rate of top labour-income earners.",
  "width": "container",
  "height": 200,
  "data": {
    "url": "data/cc3_bsyz_effective_tax_rates.csv"
  },
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "Top 100",
        "Top 400",
        "Next 300",
        "Full population"
      ],
      "title": null,
      "axis": {
        "labelLimit": 300,
        "labelExpr": "datum.label == 'Top 400' ? 'Top 400 overall' : datum.label"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.7
        }
      },
      "encoding": {
        "x": {
          "field": "rate",
          "type": "quantitative",
          "stack": "zero",
          "title": "% of economic income",
          "scale": {
            "domain": [
              0,
              50
            ]
          },
          "axis": {
            "values": [
              0,
              10,
              20,
              30,
              40,
              50
            ]
          }
        },
        "color": {
          "field": "component",
          "type": "nominal",
          "title": null,
          "sort": [
            "Income and payroll taxes",
            "Corporate taxes (worldwide)",
            "Estate and gift taxes",
            "Property and sales taxes"
          ],
          "scale": {
            "domain": [
              "Income and payroll taxes",
              "Corporate taxes (worldwide)",
              "Estate and gift taxes",
              "Property and sales taxes"
            ],
            "range": [
              "#1f4e8c",
              "#c4532d",
              "#b7a57a",
              "#7f8fa6"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "columns": 2,
            "symbolType": "square",
            "labelLimit": 400
          }
        },
        "order": {
          "field": "component_order",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "component",
            "title": "Tax"
          },
          {
            "field": "rate_share",
            "type": "quantitative",
            "title": "Share of economic income",
            "format": ".1%"
          },
          {
            "field": "total_share",
            "type": "quantitative",
            "title": "All taxes",
            "format": ".1%"
          }
        ]
      },
      "transform": [
        {
          "calculate": "datum.rate / 100",
          "as": "rate_share"
        },
        {
          "calculate": "datum.total / 100",
          "as": "total_share"
        }
      ]
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "total",
              "as": "total"
            }
          ],
          "groupby": [
            "group"
          ]
        },
        {
          "calculate": "format(datum.total, '.1f') + '%'",
          "as": "total_label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontWeight": 600,
        "fontSize": 12.5
      },
      "encoding": {
        "x": {
          "field": "total",
          "type": "quantitative"
        },
        "text": {
          "field": "total_label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 45
          }
        ]
      },
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#16191d",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": null
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 45,
            "label": "Top labour earners"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "dx": -4,
        "dy": 2,
        "y": 0,
        "fontSize": 12,
        "color": "#16191d",
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": null,
        "text": {
          "field": "label"
        }
      }
    }
  ],
  "usermeta": {
    "compactLegend": {
      "columns": 1
    }
  }
}