{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Slope chart comparing two estimates of the total effective tax rate of the top 400 US households and of the full population in 2018-20. In the Balkir-Saez-Yagan-Zucman benchmark the top 400 pay less than average; after Splinter's adjustments they pay more.",
  "width": "container",
  "height": 260,
  "data": {
    "url": "data/cc3_competing_estimates.csv"
  },
  "encoding": {
    "x": {
      "field": "estimate",
      "type": "nominal",
      "sort": [
        "Balkir et al. (2025)",
        "Splinter (2025)"
      ],
      "title": null,
      "scale": {
        "padding": 0.6
      },
      "axis": {
        "labelAngle": 0,
        "labelLimit": 400,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "rate",
      "type": "quantitative",
      "title": null,
      "scale": {
        "domain": [
          0,
          45
        ]
      }
    },
    "color": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Top 400",
          "Full population"
        ],
        "range": [
          "#c4532d",
          "#1f4e8c"
        ]
      },
      "legend": {
        "orient": "top",
        "direction": "horizontal",
        "symbolType": "stroke"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.6
      },
      "encoding": {
        "detail": {
          "field": "group"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "estimate",
            "title": "Estimate"
          },
          {
            "field": "group",
            "title": "Group"
          },
          {
            "field": "rate_share",
            "type": "quantitative",
            "title": "Total tax rate",
            "format": ".1%"
          },
          {
            "field": "note",
            "title": "Method"
          }
        ],
        "size": {
          "condition": {
            "param": "hp",
            "empty": false,
            "value": 180
          },
          "value": 90
        }
      },
      "params": [
        {
          "name": "hp",
          "select": {
            "type": "point",
            "nearest": true,
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "dy": -12,
        "fontWeight": 600,
        "fontSize": 13
      },
      "encoding": {
        "text": {
          "field": "rate_label"
        }
      }
    }
  ],
  "transform": [
    {
      "calculate": "datum.rate / 100",
      "as": "rate_share"
    },
    {
      "calculate": "format(datum.rate, '.1f') + '%'",
      "as": "rate_label"
    }
  ]
}