{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Share of homes in each council in areas that would pay less under a tax on current value that raises today's total, with bills rising with value as set by the slider (or Fairer Share's 0.48% of value).",
  "width": "container",
  "height": 600,
  "params": [
    {
      "name": "theta",
      "value": 1
    },
    {
      "name": "mode",
      "value": "national"
    },
    {
      "name": "council",
      "value": ""
    }
  ],
  "projection": {
    "type": "identity",
    "reflectY": true
  },
  "layer": [
    {
      "data": {
        "url": "project/data/msoa.csv",
        "format": {
          "parse": {
            "dwellings": "number",
            "bill": "number",
            "value": "number",
            "rate": "number",
            "sales": "number",
            "r_local": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "pow(datum.value, theta)",
          "as": "pv"
        },
        {
          "calculate": "datum.dwellings * datum.pv",
          "as": "w_pv"
        },
        {
          "calculate": "datum.dwellings * datum.bill",
          "as": "w_bill"
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "w_pv",
              "as": "pv_all"
            },
            {
              "op": "sum",
              "field": "w_bill",
              "as": "bill_all"
            }
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "w_pv",
              "as": "pv_lad"
            },
            {
              "op": "sum",
              "field": "w_bill",
              "as": "bill_lad"
            }
          ],
          "groupby": [
            "lad"
          ]
        },
        {
          "calculate": "mode == 'fairer' ? 0.0048 * datum.value : (mode == 'local' ? datum.bill_lad / datum.pv_lad : datum.bill_all / datum.pv_all) * datum.pv",
          "as": "new_bill"
        },
        {
          "calculate": "datum.new_bill < datum.bill ? datum.dwellings : 0",
          "as": "less"
        },
        {
          "calculate": "datum.new_bill * datum.dwellings",
          "as": "new_total"
        },
        {
          "calculate": "datum.bill * datum.dwellings",
          "as": "old_total"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "less",
              "as": "less"
            },
            {
              "op": "sum",
              "field": "dwellings",
              "as": "dwellings"
            },
            {
              "op": "sum",
              "field": "new_total",
              "as": "new_total"
            },
            {
              "op": "sum",
              "field": "old_total",
              "as": "old_total"
            }
          ],
          "groupby": [
            "lad",
            "council",
            "region"
          ]
        },
        {
          "calculate": "datum.less / datum.dwellings",
          "as": "share_less"
        },
        {
          "calculate": "datum.old_total / datum.dwellings",
          "as": "bill_now"
        },
        {
          "calculate": "datum.new_total / datum.dwellings",
          "as": "bill_flat"
        },
        {
          "calculate": "datum.new_total / datum.old_total - 1",
          "as": "change"
        },
        {
          "lookup": "lad",
          "from": {
            "data": {
              "url": "project/geo/hex-lad-2025.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.lad"
          },
          "as": "geo"
        },
        {
          "filter": "isValid(datum.geo)"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "share_less",
          "type": "quantitative",
          "title": null,
          "scale": {
            "type": "threshold",
            "domain": [
              0.1,
              0.25,
              0.4,
              0.6,
              0.75,
              0.9
            ],
            "range": [
              "#b8431f",
              "#d9785a",
              "#f0b9a5",
              "#eef0f2",
              "#a9bfdf",
              "#6b8fc4",
              "#2f5a99"
            ]
          },
          "legend": {
            "format": ".0%",
            "orient": "top-left",
            "direction": "vertical",
            "symbolType": "square",
            "symbolSize": 140,
            "offset": 0
          }
        },
        "tooltip": [
          {
            "field": "council",
            "title": "Council"
          },
          {
            "field": "share_less",
            "title": "Homes that would pay less",
            "type": "quantitative",
            "format": ".0%"
          },
          {
            "field": "bill_now",
            "title": "Average bill now",
            "type": "quantitative",
            "format": "$,.0f"
          },
          {
            "field": "bill_flat",
            "title": "Average bill under the reform",
            "type": "quantitative",
            "format": "$,.0f"
          },
          {
            "field": "change",
            "title": "Change in the council's total",
            "type": "quantitative",
            "format": "+.0%"
          }
        ]
      }
    },
    {
      "data": {
        "url": "project/geo/regions-2025-hex.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#16191d",
        "strokeWidth": 1.2,
        "strokeOpacity": 0.55
      }
    },
    {
      "data": {
        "url": "project/data/msoa.csv",
        "format": {
          "parse": {
            "dwellings": "number",
            "bill": "number",
            "value": "number",
            "rate": "number",
            "sales": "number",
            "r_local": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "pow(datum.value, theta)",
          "as": "pv"
        },
        {
          "calculate": "datum.dwellings * datum.pv",
          "as": "w_pv"
        },
        {
          "calculate": "datum.dwellings * datum.bill",
          "as": "w_bill"
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "w_pv",
              "as": "pv_all"
            },
            {
              "op": "sum",
              "field": "w_bill",
              "as": "bill_all"
            }
          ]
        },
        {
          "joinaggregate": [
            {
              "op": "sum",
              "field": "w_pv",
              "as": "pv_lad"
            },
            {
              "op": "sum",
              "field": "w_bill",
              "as": "bill_lad"
            }
          ],
          "groupby": [
            "lad"
          ]
        },
        {
          "calculate": "mode == 'fairer' ? 0.0048 * datum.value : (mode == 'local' ? datum.bill_lad / datum.pv_lad : datum.bill_all / datum.pv_all) * datum.pv",
          "as": "new_bill"
        },
        {
          "calculate": "datum.new_bill < datum.bill ? datum.dwellings : 0",
          "as": "less"
        },
        {
          "calculate": "datum.new_bill * datum.dwellings",
          "as": "new_total"
        },
        {
          "calculate": "datum.bill * datum.dwellings",
          "as": "old_total"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "less",
              "as": "less"
            },
            {
              "op": "sum",
              "field": "dwellings",
              "as": "dwellings"
            },
            {
              "op": "sum",
              "field": "new_total",
              "as": "new_total"
            },
            {
              "op": "sum",
              "field": "old_total",
              "as": "old_total"
            }
          ],
          "groupby": [
            "lad",
            "council",
            "region"
          ]
        },
        {
          "calculate": "datum.less / datum.dwellings",
          "as": "share_less"
        },
        {
          "calculate": "datum.old_total / datum.dwellings",
          "as": "bill_now"
        },
        {
          "calculate": "datum.new_total / datum.dwellings",
          "as": "bill_flat"
        },
        {
          "calculate": "datum.new_total / datum.old_total - 1",
          "as": "change"
        },
        {
          "lookup": "lad",
          "from": {
            "data": {
              "url": "project/geo/hex-lad-2025.geojson",
              "format": {
                "type": "json",
                "property": "features"
              }
            },
            "key": "properties.lad"
          },
          "as": "geo"
        },
        {
          "filter": "isValid(datum.geo)"
        },
        {
          "filter": "datum.lad == council"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#16191d",
        "strokeWidth": 2.5
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        }
      }
    }
  ]
}
