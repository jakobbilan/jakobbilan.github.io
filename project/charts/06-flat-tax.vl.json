{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 600,
  "projection": {
    "type": "identity",
    "reflectY": true
  },
  "description": "Share of homes in each council in areas that would pay less under a tax on current value that raises today's total, with bills rising with value as set by the page's slider (or Fairer Share's 0.48% of value). The page computes each council's result from project/data/msoa.csv and sets it in the signal 'shares'; the hexagons read their colours and tooltips from it, so a slider step recolours the map without redrawing it.",
  "params": [
    {
      "name": "council",
      "value": ""
    },
    {
      "name": "shares",
      "value": {}
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {
            "share": 0.05
          },
          {
            "share": 0.2
          },
          {
            "share": 0.3
          },
          {
            "share": 0.5
          },
          {
            "share": 0.7
          },
          {
            "share": 0.8
          },
          {
            "share": 0.95
          }
        ]
      },
      "mark": {
        "type": "point",
        "opacity": 0,
        "size": 0
      },
      "encoding": {
        "color": {
          "field": "share",
          "type": "quantitative",
          "title": null,
          "scale": {
            "type": "threshold",
            "domain": [
              0.1,
              0.25,
              0.4,
              0.6,
              0.75,
              0.9
            ],
            "range": [
              "#b8431f",
              "#d9785a",
              "#f0b9a5",
              "#eef0f2",
              "#a9bfdf",
              "#6b8fc4",
              "#2f5a99"
            ]
          },
          "legend": {
            "format": ".0%",
            "orient": "top-left",
            "direction": "vertical",
            "symbolType": "square",
            "symbolSize": 140,
            "offset": 0
          }
        }
      }
    },
    {
      "data": {
        "url": "project/geo/hex-lad-2025.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1,
        "fill": {
          "expr": "isValid(shares[datum.properties.lad]) ? scale('color', shares[datum.properties.lad].share_less) : '#eef0f2'"
        },
        "tooltip": {
          "expr": "isValid(shares[datum.properties.lad]) ? {'Council': shares[datum.properties.lad].council, 'Homes that would pay less': format(shares[datum.properties.lad].share_less, '.0%'), 'Average bill now': '£' + format(shares[datum.properties.lad].bill_now, ',.0f'), 'Average bill under the reform': '£' + format(shares[datum.properties.lad].bill_flat, ',.0f'), 'Change in the council\\'s total': format(shares[datum.properties.lad].change, '+.0%')} : null"
        }
      }
    },
    {
      "data": {
        "url": "project/geo/regions-2025-hex.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#16191d",
        "strokeWidth": 1.2,
        "strokeOpacity": 0.55
      }
    },
    {
      "data": {
        "url": "project/geo/hex-lad-2025.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.lad == council"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#16191d",
        "strokeWidth": 2.5
      }
    }
  ]
}
