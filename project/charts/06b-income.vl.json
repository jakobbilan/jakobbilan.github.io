{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Council tax as a share of household income, for each fifth of areas ranked by income: today, and under a reform that raises today's total with bills rising with value as set by the slider (or Fairer Share's 0.48% of value). Shares are average bills divided by average net household income (ONS small area income estimates).",
  "width": "container",
  "height": 270,
  "padding": {
    "top": 8,
    "right": 8,
    "bottom": 4,
    "left": 4
  },
  "data": {
    "url": "project/data/msoa.csv",
    "format": {
      "parse": {
        "dwellings": "number",
        "bill": "number",
        "value": "number",
        "r_local": "number",
        "income": "number",
        "net_income": "number",
        "income_group": "number",
        "lad": "string"
      }
    }
  },
  "params": [
    {
      "name": "theta",
      "value": 1
    },
    {
      "name": "mode",
      "value": "national"
    }
  ],
  "transform": [
    {
      "calculate": "pow(datum.value, theta)",
      "as": "pv"
    },
    {
      "calculate": "datum.dwellings * datum.pv",
      "as": "w_pv"
    },
    {
      "calculate": "datum.dwellings * datum.bill",
      "as": "w_bill"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "w_pv",
          "as": "pv_all"
        },
        {
          "op": "sum",
          "field": "w_bill",
          "as": "bill_all"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "w_pv",
          "as": "pv_lad"
        },
        {
          "op": "sum",
          "field": "w_bill",
          "as": "bill_lad"
        }
      ],
      "groupby": [
        "lad"
      ]
    },
    {
      "calculate": "mode == 'fairer' ? 0.0048 * datum.value : (mode == 'local' ? datum.bill_lad / datum.pv_lad : datum.bill_all / datum.pv_all) * datum.pv",
      "as": "new_bill"
    },
    {
      "filter": "isValid(datum.income_group) && isValid(datum.net_income)"
    },
    {
      "calculate": "datum.new_bill",
      "as": "flat_bill"
    },
    {
      "calculate": "datum.dwellings * datum.bill",
      "as": "bills"
    },
    {
      "calculate": "datum.dwellings * datum.flat_bill",
      "as": "flat_bills"
    },
    {
      "calculate": "datum.dwellings * datum.net_income",
      "as": "incomes"
    },
    {
      "calculate": "datum.flat_bill < datum.bill ? datum.dwellings : 0",
      "as": "less"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "bills",
          "as": "bills"
        },
        {
          "op": "sum",
          "field": "flat_bills",
          "as": "flat_bills"
        },
        {
          "op": "sum",
          "field": "incomes",
          "as": "incomes"
        },
        {
          "op": "sum",
          "field": "less",
          "as": "less"
        },
        {
          "op": "sum",
          "field": "dwellings",
          "as": "homes"
        }
      ],
      "groupby": [
        "income_group"
      ]
    },
    {
      "calculate": "datum.bills / datum.incomes",
      "as": "today"
    },
    {
      "calculate": "datum.flat_bills / datum.incomes",
      "as": "flat"
    },
    {
      "calculate": "datum.less / datum.homes",
      "as": "share_less"
    },
    {
      "calculate": "datum.incomes / datum.homes",
      "as": "mean_income"
    },
    {
      "calculate": "datum.flat_bills / datum.homes - datum.bills / datum.homes",
      "as": "change"
    },
    {
      "calculate": "[\"Lowest-income fifth\", \"Second fifth\", \"Middle fifth\", \"Fourth fifth\", \"Highest-income fifth\"][datum.income_group - 1]",
      "as": "group"
    }
  ],
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "Lowest-income fifth",
        "Second fifth",
        "Middle fifth",
        "Fourth fifth",
        "Highest-income fifth"
      ],
      "title": null,
      "axis": {
        "labelLimit": 170,
        "ticks": false,
        "domain": false,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5,
        "color": "#c9cdd2"
      },
      "encoding": {
        "x": {
          "field": "today",
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": true
          },
          "axis": {
            "format": ".0%",
            "tickCount": 5,
            "grid": true,
            "title": "Bill as a share of net household income"
          }
        },
        "x2": {
          "field": "flat"
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "today",
            "flat"
          ],
          "as": [
            "key",
            "share"
          ]
        },
        {
          "calculate": "datum.key == 'today' ? 'Today' : 'Reform'",
          "as": "measure"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 120,
        "opacity": 1,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative"
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "domain": [
              "Today",
              "Reform"
            ],
            "range": [
              "#5b6068",
              "#2f5a99"
            ]
          },
          "legend": {
            "orient": "top",
            "title": null,
            "symbolType": "circle",
            "symbolSize": 110,
            "labelFontSize": 12,
            "offset": 4
          }
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Areas"
          },
          {
            "field": "measure",
            "title": "Bill"
          },
          {
            "field": "share",
            "type": "quantitative",
            "format": ".1%",
            "title": "Share of household income"
          },
          {
            "field": "share_less",
            "type": "quantitative",
            "format": ".0%",
            "title": "Homes in areas that would pay less"
          },
          {
            "field": "change",
            "type": "quantitative",
            "format": "+,.0f",
            "title": "Change in average bill, £ a year"
          },
          {
            "field": "mean_income",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Mean net household income, £"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": [
            "today",
            "flat"
          ],
          "as": [
            "key",
            "share"
          ]
        },
        {
          "calculate": "datum.key == 'today' ? 'Today' : 'Reform'",
          "as": "measure"
        },
        {
          "calculate": "(datum.key == 'flat') == (datum.flat >= datum.today) ? 'left' : 'right'",
          "as": "side"
        },
        {
          "filter": "datum.side == 'left'"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 11.5,
        "fontWeight": 600,
        "align": "left",
        "dx": 9
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative"
        },
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".1%"
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "domain": [
              "Today",
              "Reform"
            ],
            "range": [
              "#5b6068",
              "#2f5a99"
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "today",
            "flat"
          ],
          "as": [
            "key",
            "share"
          ]
        },
        {
          "calculate": "datum.key == 'today' ? 'Today' : 'Reform'",
          "as": "measure"
        },
        {
          "calculate": "(datum.key == 'flat') == (datum.flat >= datum.today) ? 'left' : 'right'",
          "as": "side"
        },
        {
          "filter": "datum.side == 'right'"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 11.5,
        "fontWeight": 600,
        "align": "right",
        "dx": -9
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative"
        },
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".1%"
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "domain": [
              "Today",
              "Reform"
            ],
            "range": [
              "#5b6068",
              "#2f5a99"
            ]
          }
        }
      }
    }
  ]
}
