{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Council tax as a share of household income, for each fifth of areas ranked by income: today, and under the reform set with the page's slider and buttons. Shares are average bills divided by average net household income (ONS small area income estimates). The page computes the five groups from project/data/msoa.csv and supplies them as the dataset 'groups'.",
  "width": "container",
  "height": 270,
  "padding": {
    "top": 8,
    "right": 8,
    "bottom": 4,
    "left": 4
  },
  "transform": [],
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "sort": [
        "Lowest-income fifth",
        "Second fifth",
        "Middle fifth",
        "Fourth fifth",
        "Highest-income fifth"
      ],
      "title": null,
      "axis": {
        "labelLimit": 170,
        "ticks": false,
        "domain": false,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2.5,
        "color": "#c9cdd2"
      },
      "encoding": {
        "x": {
          "field": "today",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              0.1
            ],
            "zero": true,
            "nice": false
          },
          "axis": {
            "format": ".0%",
            "grid": true,
            "title": "Bill as a share of net household income",
            "values": [
              0,
              0.02,
              0.04,
              0.06,
              0.08,
              0.1
            ]
          }
        },
        "x2": {
          "field": "flat"
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "today",
            "flat"
          ],
          "as": [
            "key",
            "share"
          ]
        },
        {
          "calculate": "datum.key == 'today' ? 'Today' : 'Reform'",
          "as": "measure"
        }
      ],
      "mark": {
        "type": "circle",
        "size": 120,
        "opacity": 1,
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative"
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "domain": [
              "Today",
              "Reform"
            ],
            "range": [
              "#5b6068",
              "#2f5a99"
            ]
          },
          "legend": {
            "orient": "top",
            "title": null,
            "symbolType": "circle",
            "symbolSize": 110,
            "labelFontSize": 12,
            "offset": 4
          }
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Areas"
          },
          {
            "field": "measure",
            "title": "Bill"
          },
          {
            "field": "share",
            "type": "quantitative",
            "format": ".1%",
            "title": "Share of household income"
          },
          {
            "field": "share_less",
            "type": "quantitative",
            "format": ".0%",
            "title": "Homes in areas that would pay less"
          },
          {
            "field": "change",
            "type": "quantitative",
            "format": "+,.0f",
            "title": "Change in average bill, £ a year"
          },
          {
            "field": "mean_income",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Mean net household income, £"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "fold": [
            "today",
            "flat"
          ],
          "as": [
            "key",
            "share"
          ]
        },
        {
          "calculate": "datum.key == 'today' ? 'Today' : 'Reform'",
          "as": "measure"
        },
        {
          "calculate": "(datum.key == 'flat') == (datum.flat >= datum.today) ? 'left' : 'right'",
          "as": "side"
        },
        {
          "filter": "datum.side == 'left'"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 11.5,
        "fontWeight": 600,
        "align": "left",
        "dx": 9
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative"
        },
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".1%"
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "domain": [
              "Today",
              "Reform"
            ],
            "range": [
              "#5b6068",
              "#2f5a99"
            ]
          }
        }
      }
    },
    {
      "transform": [
        {
          "fold": [
            "today",
            "flat"
          ],
          "as": [
            "key",
            "share"
          ]
        },
        {
          "calculate": "datum.key == 'today' ? 'Today' : 'Reform'",
          "as": "measure"
        },
        {
          "calculate": "(datum.key == 'flat') == (datum.flat >= datum.today) ? 'left' : 'right'",
          "as": "side"
        },
        {
          "filter": "datum.side == 'right'"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 11.5,
        "fontWeight": 600,
        "align": "right",
        "dx": -9
      },
      "encoding": {
        "x": {
          "field": "share",
          "type": "quantitative"
        },
        "text": {
          "field": "share",
          "type": "quantitative",
          "format": ".1%"
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "domain": [
              "Today",
              "Reform"
            ],
            "range": [
              "#5b6068",
              "#2f5a99"
            ]
          }
        }
      }
    }
  ],
  "data": {
    "name": "groups"
  },
  "datasets": {
    "groups": []
  }
}
