      },
      "encoding": {
        "text": {
          "field": "council"
        }
      }
    },
    {
      "data": {
        "url": "project/data/reference_rates.csv",
        "format": {
          "parse": {
            "rate": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "indexof(['fairer_share', 'neutral'], datum.key) >= 0"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#c4532d",
        "strokeWidth": 1.6,
        "strokeDash": [
          6,
          4
        ],
        "opacity": {
          "expr": "step >= 2 ? 1 : 0"
        }
      },
      "encoding": {
        "y": {
          "field": "rate"
        },
        "x": null
      }
    },
    {
      "data": {
        "url": "project/data/reference_rates.csv",
        "format": {
          "parse": {
            "rate": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "indexof(['fairer_share', 'neutral'], datum.key) >= 0"
        },
        {
          "calculate": "datum.label + ': ' + format(datum.rate, '.2%')",
          "as": "text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dy": -4,
        "fontWeight": 500,
        "opacity": {
          "expr": "step >= 2 ? 1 : 0"
        },
        "fill": "#ffffff",
        "stroke": "#ffffff",
        "strokeWidth": 4,
        "strokeJoin": "round"
      },
      "encoding": {
        "y": {
          "field": "rate"
        },
        "x": {
          "value": {
            "expr": "width"
          }
        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "url": "project/data/reference_rates.csv",
