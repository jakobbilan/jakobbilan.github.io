{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Home sales at £2 million or more since January 2024, by council: the twelve councils with the most, the council chosen on the page if it is not among them, and all other councils together, so the rows add up to every such sale in England. Homes only (detached, semi-detached, terraced, flats), including purchases by companies.",
  "width": "container",
  "height": 360,
  "padding": {
    "top": 4,
    "right": 8,
    "bottom": 4,
    "left": 4
  },
  "data": {
    "url": "project/data/councils.csv",
    "format": {
      "parse": {
        "dwellings": "number",
        "band_d": "number",
        "bill": "number",
        "value": "number",
        "price": "number",
        "rate_mix": "number",
        "rate_press": "number",
        "share_ad": "number",
        "households": "number",
        "fuel_poor": "number",
        "fp_rate": "number",
        "fp_outside_ad": "number",
        "sales_2m": "number",
        "sales_all": "number",
        "r_local": "number"
      }
    }
  },
  "params": [
    {
      "name": "council",
      "value": ""
    }
  ],
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "sales_2m",
          "as": "total"
        }
      ]
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "sales_2m",
          "order": "descending"
        },
        {
          "field": "name",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.rank <= 12 ? 'top' : datum.lad == council ? 'chosen' : 'other'",
      "as": "group"
    },
    {
      "calculate": "datum.group == 'other' ? 'other' : datum.lad",
      "as": "row_lad"
    },
    {
      "calculate": "datum.group == 'other' ? '' : datum.name",
      "as": "row_name"
    },
    {
      "calculate": "datum.group == 'other' ? 99 : datum.rank",
      "as": "row_rank"
    },
    {
      "aggregate": [
        {
          "op": "sum",
          "field": "sales_2m",
          "as": "sales_2m"
        },
        {
          "op": "sum",
          "field": "sales_all",
          "as": "sales_all"
        },
        {
          "op": "count",
          "as": "n"
        },
        {
          "op": "max",
          "field": "total",
          "as": "total"
        }
      ],
      "groupby": [
        "group",
        "row_lad",
        "row_name",
        "row_rank"
      ]
    },
    {
      "calculate": "datum.sales_2m / datum.total",
      "as": "share"
    },
    {
      "calculate": "datum.group == 'other' ? datum.n + ' other councils' : datum.group == 'chosen' ? datum.row_name + ' (' + datum.row_rank + (datum.row_rank % 100 >= 11 && datum.row_rank % 100 <= 13 ? 'th' : datum.row_rank % 10 == 1 ? 'st' : datum.row_rank % 10 == 2 ? 'nd' : datum.row_rank % 10 == 3 ? 'rd' : 'th') + ')' : datum.row_name",
      "as": "label"
    },
    {
      "calculate": "pad(datum.group == 'other' ? 99 : datum.group == 'chosen' ? 98 : datum.row_rank, 2, '0', 'left') + '|' + datum.row_lad + '|' + datum.label",
      "as": "order"
    },
    {
      "calculate": "datum.row_lad",
      "as": "lad"
    },
    {
      "calculate": "datum.row_name",
      "as": "name"
    }
  ],
  "encoding": {
    "y": {
      "field": "order",
      "type": "nominal",
      "sort": "ascending",
      "title": null,
      "axis": {
        "grid": false,
        "labelLimit": 180,
        "labelExpr": "split(datum.label, '|')[2]",
        "labelColor": {
          "condition": {
            "test": "split(datum.value, '|')[1] == council",
            "value": "#16191d"
          },
          "value": "#5b636d"
        },
        "labelFontWeight": {
          "condition": {
            "test": "split(datum.value, '|')[1] == council",
            "value": 600
          },
          "value": 400
        }
      }
    },
    "x": {
      "field": "sales_2m",
      "type": "quantitative",
      "title": null,
      "axis": {
        "grid": true,
        "labels": false,
        "ticks": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.72
        },
        "cornerRadiusEnd": 1
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "datum.lad == council",
            "value": "#1f4e8c"
          },
          "value": "#bccbe0"
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Council"
          },
          {
            "field": "sales_2m",
            "title": "Sales at £2m or more",
            "type": "quantitative",
            "format": ","
          },
          {
            "field": "share",
            "title": "Share of England's £2m+ sales",
            "type": "quantitative",
            "format": ".1%"
          },
          {
            "field": "sales_all",
            "title": "All sales",
            "type": "quantitative",
            "format": ","
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.group != 'other'"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "color": "#5b636d",
        "fontSize": 11.5
      },
      "encoding": {
        "text": {
          "field": "sales_2m",
          "type": "quantitative",
          "format": ","
        },
        "opacity": {
          "condition": {
            "test": "datum.lad == council",
            "value": 0
          },
          "value": 1
        }
      },
      "transform": [
        {
          "filter": "datum.group != 'other'"
        }
      ]
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "color": "#16191d",
        "fontSize": 11.5,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "sales_2m",
          "type": "quantitative",
          "format": ","
        },
        "opacity": {
          "condition": {
            "test": "datum.lad == council",
            "value": 1
          },
          "value": 0
        }
      },
      "transform": [
        {
          "filter": "datum.group != 'other'"
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.group == 'other'"
        },
        {
          "calculate": "format(datum.sales_2m, ',') + ' sales, ' + format(datum.share, '.0%') + ' of all'",
          "as": "rest"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 2,
        "color": "#5b636d",
        "fontSize": 11.5,
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "text": {
          "field": "rest"
        }
      }
    }
  ]
}
